	column DayOfWeek
		dataType: string
		lineageTag: e1456303-24f2-4057-c532-f2d3d036a1ee
		summarizeBy: none
		sourceColumn: DayOfWeek
		sortByColumn: DayOfWeekNo

		annotation SummarizationSetBy = Automatic

	/// 1 = Monday … 7 = Sunday; sort key for DayOfWeek.
	column DayOfWeekNo
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f2567414-3503-4168-d643-03e4e147b2ff
		summarizeBy: none
		sourceColumn: DayOfWeekNo

		annotation SummarizationSetBy = Automatic

	/// First day of the order's month; axis for the monthly sales trend.
	column OrderMonth
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 03678525-4614-4279-e754-14f5f258c310
		summarizeBy: none
		sourceColumn: OrderMonth

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition CoffeeShop_Sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "CoffeeShop_Sales.csv"), [Delimiter = ",", Columns = 10, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"OrderID", type text}, {"OrderDate", type date}, {"OrderTime", type time}, {"Product", type text}, {"Category", type text}, {"Quantity", Int64.Type}, {"UnitPrice", type number}, {"SalesAmount", type number}, {"PaymentMethod", type text}, {"DayOfWeek", type text}}, "en-US"),
				    #"Added DayOfWeekNo" = Table.AddColumn(#"Changed Type", "DayOfWeekNo", each Date.DayOfWeek([OrderDate], Day.Monday) + 1, Int64.Type),
				    #"Added OrderMonth" = Table.AddColumn(#"Added DayOfWeekNo", "OrderMonth", each Date.StartOfMonth([OrderDate]), type date)
				in
				    #"Added OrderMonth"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

