		lineageTag: 8bef0da7-ce9c-4af1-afdb-9cfd7ed0ab88
		summarizeBy: none
		sourceColumn: Product

		annotation SummarizationSetBy = Automatic

	column Category
		dataType: string
		lineageTag: 9cf01eb8-dfad-4b02-b0ec-ad0e8fe1bc99
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column Quantity
		dataType: int64
		formatString: #,0
		lineageTag: ad012fc9-e0be-4c13-81fd-be1f9af2cdaa
		summarizeBy: sum
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

	column UnitPrice
		dataType: double
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: be1230da-f1cf-4d24-92ae-cfa0ad03debb
		summarizeBy: none
		sourceColumn: UnitPrice

		annotation SummarizationSetBy = User

	column SalesAmount
		dataType: double
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: cf2341eb-02d0-4e35-a310-d0b1be14efcc
		summarizeBy: sum
		sourceColumn: SalesAmount

